# ========================
# Python / Django .gitignore
# ========================

# Virtual environments
# --------------------
.venv/
env/
venv/
ENV/
env.bak/
*/venv/ # Ignore venv directories in subdirectories (e.g., if you have multiple apps with their own venvs)
key.json
# Byte-compiled / optimized / DLL files
# -------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
# ------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Logs and databases
# ------------------
*.log
*.pot
*.mo
*.sqlite3
db.sqlite3 # Django's default SQLite database file
/media/ # User-uploaded files (should be handled by Django storage backend in production, not committed)
/uploads/ # Another common name for user-uploaded files
tmp/ # Temporary files, often generated by Django/Python processes

# IDE and OS-specific files
# -------------------------
.idea/          # PyCharm
.vscode/        # VS Code
*.iml           # IntelliJ IDEA
.DS_Store       # macOS
.Trashes        # macOS
Thumbs.db       # Windows
ehthumbs.db     # Windows
desktop.ini     # Windows

# Environment variables
# ---------------------
.env            # Common .env file for local variables
.flaskenv       # Flask-specific .env (if you also use Flask in some context)
instance/       # Flask-specific instance folder
*.env
.vault_pass.txt # Ansible vault password file (if applicable)

# Testing and coverage
# --------------------
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
htmlcov/

# Jupyter Notebook files
# ----------------------
.ipynb_checkpoints

# Celery beat schedule files
# --------------------------
celerybeat-schedule

# Pip files
# ---------
pip-log.txt
pip-delete-this-directory.txt

# Other temporary files
# ---------------------
*~
*.bak
*.swp
*.swo

# Black / flake8 cache
.mypy_cache/
.ruff_cache/

# Docker related files (if not part of production setup)
# -------------------------------------------------------
.dockerignore # Sometimes you want to version this, sometimes not
.env-docker
docker-compose.override.yml # Often temporary overrides

# Front-end build artifacts (if your Django project includes a front-end build step)
# ----------------------------------------------------------------------------------
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*